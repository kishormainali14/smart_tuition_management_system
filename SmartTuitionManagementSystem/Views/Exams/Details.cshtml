@model SmartTuitionManagementSystem.Entities.ExamEntity

@{
    ViewData["Title"] = "Exam Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Exam Details
                    </h4>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Exam Name:</label>
                            <p class="mt-1">@Model.ExamName</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Exam Code:</label>
                            <p class="mt-1"><span class="badge bg-secondary">@Model.ExamCode</span></p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Exam Type:</label>
                            <p class="mt-1">@Model.ExamType</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Academic Year:</label>
                            <p class="mt-1">@Model.AcademicYear</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Semester:</label>
                            <p class="mt-1">@Model.Section</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Status:</label>
                            <p class="mt-1">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Created Date:</label>
                            <p class="mt-1">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-primary">Last Modified:</label>
                            <p class="mt-1">
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    @Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">Not modified yet</span>
                                }
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="col-12 mb-3">
                                <label class="fw-bold text-primary">Description:</label>
                                <p class="mt-1">@Model.Description</p>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>