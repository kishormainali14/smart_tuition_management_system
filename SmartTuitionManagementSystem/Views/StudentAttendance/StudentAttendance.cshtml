@model SmartTuitionManagementSystem.Models.DailyAttendanceViewModel

@{
    ViewData["Title"] = "Student Attendance";
}

<div class="container-fluid mt-4">

    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle fa-lg me-2"></i>
                <strong>Please fix the following errors:</strong>
            </div>
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Selection Form -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="StudentAttendance" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label asp-for="SelectedClassId" class="form-label fw-semibold small text-uppercase text-muted"></label>
                    <select asp-for="SelectedClassId" asp-items="Model.ClassList" class="form-select">
                        <option value="">-- Select Class --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label fw-semibold small text-uppercase text-muted"></label>
                    <input asp-for="SelectedDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-search me-1"></i> Load Students
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Students.Any())
    {
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm bg-primary bg-gradient text-white h-100">
                    <div class="card-body text-center py-3">
                        <i class="fas fa-users fa-2x mb-2 opacity-75"></i>
                        <h6 class="card-title small text-uppercase opacity-75 mb-1">Total Students</h6>
                        <h2 class="mb-0 fw-bold" id="totalCount">@Model.TotalStudents</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm bg-success bg-gradient text-white h-100">
                    <div class="card-body text-center py-3">
                        <i class="fas fa-check-circle fa-2x mb-2 opacity-75"></i>
                        <h6 class="card-title small text-uppercase opacity-75 mb-1">Present</h6>
                        <h2 class="mb-0 fw-bold" id="presentCount">@Model.PresentCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm bg-danger bg-gradient text-white h-100">
                    <div class="card-body text-center py-3">
                        <i class="fas fa-times-circle fa-2x mb-2 opacity-75"></i>
                        <h6 class="card-title small text-uppercase opacity-75 mb-1">Absent</h6>
                        <h2 class="mb-0 fw-bold" id="absentCount">@Model.AbsentCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm bg-warning bg-gradient text-white h-100">
                    <div class="card-body text-center py-3">
                        <i class="fas fa-clock fa-2x mb-2 opacity-75"></i>
                        <h6 class="card-title small text-uppercase opacity-75 mb-1">On Leave</h6>
                        <h2 class="mb-0 fw-bold" id="leaveCount">@Model.LeaveCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold me-2"><i class="fas fa-bolt text-primary me-1"></i> Quick Actions:</span>
                    <button type="button" class="btn btn-success btn-sm" onclick="markAll('Present')">
                        <i class="fas fa-check-circle me-1"></i> All Present
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" onclick="markAll('Absent')">
                        <i class="fas fa-times-circle me-1"></i> All Absent
                    </button>
                    <button type="button" class="btn btn-warning btn-sm text-white" onclick="markAll('Leave')">
                        <i class="fas fa-clock me-1"></i> All Leave
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyFromPrevious()">
                        <i class="fas fa-copy me-1"></i> Copy Previous Day
                    </button>
                    <span class="ms-auto text-muted small">
                        <i class="fas fa-keyboard me-1"></i>
                        <kbd class="bg-light text-dark border px-1">P</kbd> Present
                        <kbd class="bg-light text-dark border px-1">A</kbd> Absent
                        <kbd class="bg-light text-dark border px-1">L</kbd> Leave
                    </span>
                </div>
            </div>
        </div>

        <!-- Attendance Form -->
        <form method="post" asp-action="SaveAttendance" id="attendanceForm">
            <input type="hidden" asp-for="SelectedDate" />
            <input type="hidden" asp-for="SelectedClassId" />

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th class="ps-3" style="width: 40px;">#</th>
                                    <th>Student Name</th>
                                    <th>Email</th>
                                    <th style="width: 280px;">Status</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Students.Count; i++)
                                {
                                    <tr class="attendance-row">
                                        <td class="ps-3 text-muted">@(i + 1)</td>
                                        <td>
                                            <strong>@Model.Students[i].FullName</strong>
                                            <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                            <input type="hidden" asp-for="@Model.Students[i].AttendanceId" />
                                        </td>
                                        <td class="text-muted small">@Model.Students[i].Email</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check" asp-for="@Model.Students[i].Status" value="Present" id="present_@i" autocomplete="off" onchange="updateSummary()">
                                                <label class="btn btn-outline-success @(Model.Students[i].Status == "Present" ? "active" : "")" for="present_@i">
                                                    <i class="fas fa-check-circle me-1"></i> Present
                                                </label>
                                                <input type="radio" class="btn-check" asp-for="@Model.Students[i].Status" value="Absent" id="absent_@i" autocomplete="off" onchange="updateSummary()">
                                                <label class="btn btn-outline-danger @(Model.Students[i].Status == "Absent" ? "active" : "")" for="absent_@i">
                                                    <i class="fas fa-times-circle me-1"></i> Absent
                                                </label>
                                                <input type="radio" class="btn-check" asp-for="@Model.Students[i].Status" value="Leave" id="leave_@i" autocomplete="off" onchange="updateSummary()">
                                                <label class="btn btn-outline-warning @(Model.Students[i].Status == "Leave" ? "active" : "")" for="leave_@i">
                                                    <i class="fas fa-clock me-1"></i> Leave
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" asp-for="@Model.Students[i].Remarks" class="form-control form-control-sm" placeholder="Optional..." />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="fas fa-save me-1"></i> Save Attendance
                        </button>
                        <a asp-action="StudentAttendance"
                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           asp-route-selectedClassId="@Model.SelectedClassId"
                           class="btn btn-outline-secondary btn-lg px-4">
                            <i class="fas fa-sync me-1"></i> Refresh
                        </a>
                    </div>
                </div>
            </div>
        </form>
    }
    else if (Model.SelectedClassId > 0)
    {
        <div class="alert alert-info text-center shadow-sm border-0">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <h5>No students found for the selected class.</h5>
            <p class="mb-0">Please add students to this class first.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateSummary() {
            let present = 0, absent = 0, leave = 0;

            document.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
                const value = radio.value;
                if (value === 'Present') present++;
                else if (value === 'Absent') absent++;
                else if (value === 'Leave') leave++;
            });

            const total = present + absent + leave;
            const percentage = total > 0 ? (present / total * 100).toFixed(1) : 0;

            document.getElementById('presentCount').innerText = present;
            document.getElementById('absentCount').innerText = absent;
            document.getElementById('leaveCount').innerText = leave;
            document.getElementById('attendancePercent').innerText = percentage + '%';
        }

        function markAll(status) {
            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                if (radio.value === status) {
                    radio.checked = true;
                    radio.dispatchEvent(new Event('change'));
                }
            });
            updateSummary();
        }

        async function copyFromPrevious() {
            const date = document.querySelector('input[name="SelectedDate"]').value;
            const classId = document.querySelector('input[name="SelectedClassId"]')?.value || '';

            if (!classId) {
                alert('Please select a class first');
                return;
            }

            if (confirm('Copy attendance from previous day? This will overwrite current selections.')) {
                try {
                    const url = `/StudentAttendance/CopyFromPrevious?date=${date}&classId=${classId}`;
                    const response = await fetch(url);
                    const students = await response.json();

                    students.forEach((student, index) => {
                        const radio = document.querySelector(`input[name="Students[${index}].Status"][value="${student.status}"]`);
                        if (radio) {
                            radio.checked = true;
                            radio.dispatchEvent(new Event('change'));
                        }

                        const remarksInput = document.querySelector(`input[name="Students[${index}].Remarks"]`);
                        if (remarksInput) {
                            remarksInput.value = student.remarks || '';
                        }
                    });

                    updateSummary();
                    alert('Copied from previous day successfully!');
                } catch (error) {
                    console.error('Error:', error);
                    alert('Failed to copy from previous day');
                }
            }
        }

        document.addEventListener('keydown', function(e) {
            const activeElement = document.activeElement;
            const isInputFocused = activeElement.tagName === 'INPUT' || activeElement.tagName === 'TEXTAREA';

            if (!isInputFocused) {
                switch(e.key.toLowerCase()) {
                    case 'p': markAll('Present'); break;
                    case 'a': markAll('Absent'); break;
                    case 'l': markAll('Leave'); break;
                }
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            updateSummary();
        });
    </script>
}
