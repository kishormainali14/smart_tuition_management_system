@model SmartTuitionManagementSystem.Models.ClassViewModel

@{
    ViewData["Title"] = "Add Class";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-school me-2"></i>
                        Add New Class
                    </h4>
                </div>

                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <form asp-action="AddClass" asp-controller="Class" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Grade" class="form-label fw-semibold"></label>
                                <select asp-for="Grade" asp-items="Model.GradeOptions" class="form-select">
                                    <option value="">-- Select Grade --</option>
                                </select>
                                <span asp-validation-for="Grade" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ClassCode" class="form-label fw-semibold"></label>
                                <input asp-for="ClassCode" class="form-control" placeholder="e.g., C1, LKG" />
                                <span asp-validation-for="ClassCode" class="text-danger"></span>
                                <small class="text-muted">Optional. Will be auto-generated if left blank.</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Section" class="form-label fw-semibold"></label>
                                <input asp-for="Section" class="form-control" placeholder="A, B, C..." />
                                <span asp-validation-for="Section" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
                                <input asp-for="RoomNumber" class="form-control" placeholder="e.g., 101, Room A" />
                                <span asp-validation-for="RoomNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxCapacity" class="form-label fw-semibold"></label>
                                <input asp-for="MaxCapacity" type="number" class="form-control" />
                                <span asp-validation-for="MaxCapacity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AcademicYear" class="form-label fw-semibold"></label>
                                <input asp-for="AcademicYear" class="form-control" placeholder="2024" />
                                <span asp-validation-for="AcademicYear" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" rows="3" class="form-control" placeholder="Optional description about this class"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>
                                Save Class
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // Show validation summary if there are errors
            if (!@ViewData.ModelState.IsValid.ToString().ToLower()) {
                $('div[asp-validation-summary="All"]').show();
            }
            
            // Log form submission
            $('#studentForm').on('submit', function() {
                console.log('Form is being submitted');
                if ($(this).valid()) {
                    console.log('Form is valid');
                } else {
                    console.log('Form has validation errors');
                }
            });
        });
    </script>
}