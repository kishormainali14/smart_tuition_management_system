@model SmartTuitionManagementSystem.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">
                    <i class="fas fa-lock me-2"></i>Reset Password
                </h4>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    <strong>@Model.Email</strong><br />
                    Please enter your new password below.
                </p>

                <form asp-action="ResetPassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="fas fa-key me-1"></i>New Password
                        </label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <small class="text-muted">Password must be at least 6 characters</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="fas fa-check-circle me-1"></i>Confirm New Password
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-save me-2"></i>Save New Password
                    </button>
                </form>
            </div>
            <div class="card-footer text-center">
                <small>
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i>Back to Login
                    </a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}