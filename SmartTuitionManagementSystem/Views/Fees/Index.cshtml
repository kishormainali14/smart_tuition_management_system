@model List<FeeStructureViewModel>
@using SmartTuitionManagementSystem.Models
@{
    ViewData["Title"] = "Fee Management";
    var dashboard = ViewBag.Dashboard as FeeDashboardViewModel;
    var feeTypes = ViewBag.FeeTypes as List<FeeStructureViewModel> ?? new();
    var classList = ViewBag.ClassList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var feeTypeList = ViewBag.FeeTypeList as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid px-4">
    @if (ViewBag.PageError != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.PageError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Loading Indicator -->
    <div id="pageLoader" class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2">Loading fee management data...</p>
    </div>

    <div id="pageContent" style="display: none;">
    <!-- Dashboard Cards -->
    @if (dashboard != null)
    {
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Collected</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@dashboard.TotalCollected.ToString("C")</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-rupee-sign fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Due</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@dashboard.TotalDue.ToString("C")</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Today's Collection</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@dashboard.TodayCollection.ToString("C")</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-calendar-day fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Overdue</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@dashboard.OverdueCount Students</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-clock fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Fee Structures Section -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-table me-1"></i> Fee Structures</span>
            <div>
                <button type="button" class="btn btn-sm btn-success me-2" data-bs-toggle="modal" data-bs-target="#feeTypeModal">
                    <i class="fas fa-plus"></i> Add Fee Type
                </button>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus"></i> Add Fee Structure
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No fee structures defined yet. Click "Add Fee Structure" to create one.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="feeStructuresTable">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Fee Type</th>
                                <th>Amount</th>
                                <th>Due Date</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ClassName</td>
                                    <td>@item.FeeTypeName</td>
                                    <td>@item.Amount.ToString("C")</td>
                                    <td>@(item.DueDate?.ToString("dd MMM yyyy") ?? "N/A")</td>
                                    <td>@(item.Description ?? "-")</td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteFeeStructure(@item.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Payments -->
    @if (dashboard?.RecentPayments.Any() == true)
    {
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-history me-1"></i> Recent Payments
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in dashboard.RecentPayments)
                            {
                                <tr>
                                    <td>@payment.StudentName</td>
                                    <td>@payment.AmountPaid.ToString("C")</td>
                                    <td>@payment.PaymentMethod</td>
                                    <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
</div>

<!-- Fee Type Modal -->
<div class="modal fade" id="feeTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="feeTypeForm" method="post" asp-action="CreateFeeType">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Fee Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Fee Type Name</label>
                        <input type="text" name="feeTypeName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#pageLoader').hide();
            $('#pageContent').fadeIn('fast');
        });

        function deleteFeeStructure(id) {
            if (!confirm('Are you sure you want to delete this fee structure?')) return;
            $.post('@Url.Action("Delete", "Fees")', { id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                .done(function(r) {
                    if (r.success) { location.reload(); }
                    else { alert(r.message); }
                });
        }

        $('#feeTypeForm').submit(function(e) {
            e.preventDefault();
            var form = $(this);
            $.post(form.attr('action'), form.serialize())
                .done(function(r) {
                    if (r.success) { location.reload(); }
                    else { alert(r.message); }
                });
        });
    </script>
}
