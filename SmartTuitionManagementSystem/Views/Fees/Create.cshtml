@model FeeStructureViewModel
@{
    ViewData["Title"] = "Add Fee Structure";
    ViewBag.HidePageHeader = true;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Add Fee Structure</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Fees" asp-action="Index">Fee Management</a></li>
        <li class="breadcrumb-item active">Add Fee Structure</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-plus me-1"></i> New Fee Structure
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="ClassId" class="form-label"></label>
                        <select asp-for="ClassId" asp-items="Model.ClassList" class="form-select">
                            <option value="">-- Select Class --</option>
                        </select>
                        <span asp-validation-for="ClassId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FeeTypeId" class="form-label"></label>
                        <select asp-for="FeeTypeId" asp-items="Model.FeeTypeList" class="form-select">
                            <option value="">-- Select Fee Type --</option>
                        </select>
                        <span asp-validation-for="FeeTypeId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">Rs</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" class="form-control" type="date" />
                        <span asp-validation-for="DueDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Create
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
