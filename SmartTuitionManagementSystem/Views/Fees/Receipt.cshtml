@model FeeReceiptViewModel
@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Payment Receipt</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Collections">Collections</a></li>
        <li class="breadcrumb-item active">Receipt</li>
    </ol>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header text-center bg-primary text-white">
                    <h4 class="mb-0">Payment Receipt</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h5>Smart Tuition Management System</h5>
                        <small class="text-muted">Receipt #: @Model.ReceiptNumber</small>
                        <br />
                        <small class="text-muted">Generated: @Model.GeneratedAt.ToString("dd MMM yyyy hh:mm tt")</small>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td><strong>Student Name:</strong></td><td>@Model.StudentName</td></tr>
                                <tr><td><strong>Roll Number:</strong></td><td>@Model.RollNumber</td></tr>
                                <tr><td><strong>Class:</strong></td><td>@Model.ClassName</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td><strong>Parent Name:</strong></td><td>@Model.ParentName</td></tr>
                                <tr><td><strong>Parent Phone:</strong></td><td>@Model.ParentPhone</td></tr>
                                <tr><td><strong>Fee Type:</strong></td><td>@Model.FeeTypeName</td></tr>
                            </table>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-12">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Model.FeeTypeName - @Model.ClassName</td>
                                        <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                                    </tr>
                                    <tr class="table-success">
                                        <td><strong>Amount Paid</strong></td>
                                        <td class="text-end"><strong>@Model.AmountPaid.ToString("C")</strong></td>
                                    </tr>
                                    <tr class="table-warning">
                                        <td><strong>Remaining Balance</strong></td>
                                        <td class="text-end"><strong>@Model.RemainingBalance.ToString("C")</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Payment Method:</strong> @Model.PaymentMethod
                        </div>
                        <div class="col-md-6">
                            <strong>Payment Date:</strong> @Model.PaymentDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.TransactionReference))
                    {
                        <div class="row mb-3">
                            <div class="col-12">
                                <strong>Transaction Reference:</strong> @Model.TransactionReference
                            </div>
                        </div>
                    }

                    <hr />

                    <div class="text-center mt-4">
                        <p class="text-muted">Thank you for the payment!</p>
                        <button onclick="window.print()" class="btn btn-primary">
                            <i class="fas fa-print"></i> Print Receipt
                        </button>
                        <a asp-action="Collections" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Collections
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
