@model SmartTuitionManagementSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "Add User";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9 col-md-10">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user-plus me-2"></i>Add New User
                    </h6>
                    <a asp-controller="Account" asp-action="Users" class="btn btn-sm btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Users
                    </a>
                </div>
                <div class="card-body">
                    <!-- Display validation summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;" id="validationSummary"></div>

                    <!-- Display success message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Display error message -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="AddUser" asp-controller="Account" method="post" id="registerForm">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">
                                    <i class="fas fa-user text-primary me-1"></i> Full Name
                                </label>
                                <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Username" class="form-label fw-bold">
                                    <i class="fas fa-id-card text-primary me-1"></i> Username
                                </label>
                                <div class="input-group">
                                    <input asp-for="Username" class="form-control" placeholder="Choose a username" />
                                    <button type="button" class="btn btn-outline-secondary" id="checkUsernameBtn" title="Check Availability">
                                        <i class="fas fa-check-circle"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                                <small id="usernameAvailability" class="form-text"></small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">
                                    <i class="fas fa-envelope text-primary me-1"></i> Email Address
                                </label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="user@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Contact" class="form-label fw-bold">
                                    <i class="fas fa-phone text-primary me-1"></i> Contact Number
                                </label>
                                <input asp-for="Contact" class="form-control" placeholder="+1234567890" />
                                <span asp-validation-for="Contact" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="fas fa-location-dot text-primary me-1"></i> Address
                            </label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter complete address"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-bold">
                                    <i class="fas fa-lock text-primary me-1"></i> Password
                                </label>
                                <div class="input-group">
                                    <input asp-for="Password" class="form-control" type="password" id="password" placeholder="Create a strong password" />
                                    <button type="button" class="btn btn-outline-secondary toggle-password" data-target="password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <small class="form-text text-muted">Password must be at least 6 characters long.</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold">
                                    <i class="fas fa-lock text-primary me-1"></i> Confirm Password
                                </label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPassword" placeholder="Re-enter password" />
                                    <button type="button" class="btn btn-outline-secondary toggle-password" data-target="confirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Password Strength Indicator -->
                        <div class="mb-3">
                            <div class="progress" style="height: 5px;">
                                <div id="passwordStrength" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                            </div>
                            <small id="passwordStrengthText" class="form-text"></small>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Account" asp-action="Users" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save me-1"></i> Create User
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Information Card -->
            <div class="card shadow">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center mb-3 mb-md-0">
                            <i class="fas fa-info-circle fa-3x text-primary"></i>
                        </div>
                        <div class="col-md-10">
                            <h6 class="fw-bold mb-2">User Role Information</h6>
                            <p class="mb-0 small text-muted">
                                New users are created with <strong>Admin</strong> role by default. 
                                You can modify user roles and permissions from the User Management panel after creation.
                                All fields marked with <span class="text-danger">*</span> are required.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.75rem;
        }
        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }
        .form-label {
            font-size: 0.875rem;
            margin-bottom: 0.25rem;
        }
        .form-control:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }
        .password-strength-weak { background-color: #e74a3b; width: 25%; }
        .password-strength-fair { background-color: #f6c23e; width: 50%; }
        .password-strength-good { background-color: #36b9cc; width: 75%; }
        .password-strength-strong { background-color: #1cc88a; width: 100%; }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toggle password visibility
            $('.toggle-password').click(function() {
                const target = $(this).data('target');
                const input = $('#' + target);
                const icon = $(this).find('i');
                
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Password strength checker
            $('#password').on('keyup', function() {
                const password = $(this).val();
                const strengthBar = $('#passwordStrength');
                const strengthText = $('#passwordStrengthText');
                
                let strength = 0;
                let message = '';
                let className = '';
                
                if (password.length > 0) {
                    // Length check
                    if (password.length >= 8) strength += 25;
                    else if (password.length >= 6) strength += 15;
                    
                    // Lowercase letter check
                    if (password.match(/[a-z]/)) strength += 25;
                    
                    // Uppercase letter check
                    if (password.match(/[A-Z]/)) strength += 25;
                    
                    // Number check
                    if (password.match(/[0-9]/)) strength += 15;
                    
                    // Special character check
                    if (password.match(/[^a-zA-Z0-9]/)) strength += 10;
                    
                    if (strength < 30) {
                        message = 'Weak password';
                        className = 'password-strength-weak';
                    } else if (strength < 60) {
                        message = 'Fair password';
                        className = 'password-strength-fair';
                    } else if (strength < 80) {
                        message = 'Good password';
                        className = 'password-strength-good';
                    } else {
                        message = 'Strong password';
                        className = 'password-strength-strong';
                    }
                    
                    strengthBar.css('width', strength + '%');
                    strengthText.text(message).removeClass('text-muted text-danger text-warning text-success');
                    
                    if (strength < 30) strengthText.addClass('text-danger');
                    else if (strength < 60) strengthText.addClass('text-warning');
                    else if (strength < 80) strengthText.addClass('text-info');
                    else strengthText.addClass('text-success');
                } else {
                    strengthBar.css('width', '0%');
                    strengthText.text('').addClass('text-muted');
                }
            });

            // Username availability check
            let usernameCheckTimeout;
            $('#Username').on('keyup', function() {
                clearTimeout(usernameCheckTimeout);
                const username = $(this).val();
                const availabilitySpan = $('#usernameAvailability');
                
                if (username.length >= 3) {
                    usernameCheckTimeout = setTimeout(function() {
                        $.ajax({
                            url: '@Url.Action("CheckUsernameAvailability", "Account")',
                            type: 'GET',
                            data: { username: username },
                            success: function(response) {
                                if (response.available) {
                                    availabilitySpan.html('<i class="fas fa-check-circle text-success"></i> Username is available')
                                        .removeClass('text-danger').addClass('text-success');
                                } else {
                                    availabilitySpan.html('<i class="fas fa-times-circle text-danger"></i> Username already taken')
                                        .removeClass('text-success').addClass('text-danger');
                                }
                            }
                        });
                    }, 500);
                } else if (username.length > 0) {
                    availabilitySpan.html('<i class="fas fa-info-circle text-warning"></i> Username must be at least 3 characters')
                        .removeClass('text-success text-danger').addClass('text-warning');
                } else {
                    availabilitySpan.html('');
                }
            });

            // Form validation before submit
            $('#registerForm').on('submit', function(e) {
                const password = $('#password').val();
                const confirmPassword = $('#confirmPassword').val();
                
                if (password !== confirmPassword) {
                    e.preventDefault();
                    showValidationError('Password and Confirm Password do not match.');
                    return false;
                }
                
                if (password.length < 6) {
                    e.preventDefault();
                    showValidationError('Password must be at least 6 characters long.');
                    return false;
                }
                
                return true;
            });
            
            function showValidationError(message) {
                const summary = $('#validationSummary');
                summary.html('<i class="fas fa-exclamation-circle me-2"></i> ' + message);
                summary.show();
                
                setTimeout(function() {
                    summary.fadeOut('slow');
                }, 5000);
            }
            
            // Display model validation errors properly
            if ($('.field-validation-error').length > 0) {
                let errorMessages = [];
                $('.field-validation-error').each(function() {
                    if ($(this).text().trim()) {
                        errorMessages.push($(this).text().trim());
                    }
                });
                if (errorMessages.length > 0) {
                    $('#validationSummary').html('<i class="fas fa-exclamation-circle me-2"></i> ' + errorMessages.join('<br>')).show();
                }
            }
        });
    </script>
    
    @await Html.PartialAsync("_ValidationScriptsPartial")
}