@model SmartTuitionManagementSystem.Models.EditAttendanceViewModel

@{
    ViewData["Title"] = "Edit Attendance";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning">
            <h3 class="mb-0">Edit Attendance - @Model.TeacherName</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="TeacherId" />
                <input type="hidden" asp-for="TeacherName" />
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Date" class="control-label"></label>
                            <input asp-for="Date" class="form-control" type="date" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Status" class="control-label"></label>
                            <select asp-for="Status" class="form-control" asp-items="Model.StatusOptions"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="CheckInTime" class="control-label"></label>
                            <input asp-for="CheckInTime" class="form-control" placeholder="HH:mm" />
                            <span asp-validation-for="CheckInTime" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="CheckOutTime" class="control-label"></label>
                            <input asp-for="CheckOutTime" class="form-control" placeholder="HH:mm" />
                            <span asp-validation-for="CheckOutTime" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Remarks" class="control-label"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3 form-check">
                            <input asp-for="IsApproved" class="form-check-input" />
                            <label asp-for="IsApproved" class="form-check-label"></label>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="TeacherWise" asp-route-id="@Model.TeacherId" class="btn btn-secondary">Back to List</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}